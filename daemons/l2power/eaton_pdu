#!/usr/bin/env python3
"""Daemon for the Eaton EMAT-08/10 PDU, over Telnet.

Config, connecting, and outlet state/name/lock come from PduDaemon. This adds
what only an Eaton has: per-outlet current, power, energy and auto-restart,
plus manufacturer and serial number.
"""

from typing import Any

from lris2.driver.pdu.src.emat08_10 import EatonEMAT
from pdu_base import PduDaemon, main

# AutomaticRestart values the PDU accepts: not powered, powered, last state
AUTORESTART_VALUES = (0, 1, 2)


class EatonPdu(PduDaemon):  # pylint: disable=W0223,too-many-public-methods
    """Daemon for one Eaton EMAT-08/10 PDU."""

    def __init__(self) -> None:
        super().__init__()
        self.dev = EatonEMAT(log=True)

    def connect(self) -> bool:
        return bool(self.dev.connect(self.host, self.port,
                                     username=self.username, password=self.password))

    def disconnect(self) -> None:
        self.dev.disconnect()

    def is_connected(self) -> bool:
        return bool(self.dev.is_connected())

    def initialize(self) -> bool:
        return bool(self.dev.initialize())

    def reported_outlet_count(self) -> int | None:
        return self.dev.outlet_count or None

    def get_model(self) -> str:
        return self._device("model")

    def get_firmware(self) -> str:
        return self._device("version")

    def get_outlet_state(self, n: int) -> bool:
        return bool(self._outlet(n, "outlet_status"))

    def set_outlet_state(self, n: int, on: bool) -> None:
        self._confirm(self.dev.outlet_on(n) if on else self.dev.outlet_off(n),
                      f"switch outlet {n} {'on' if on else 'off'}")

    def get_outlet_name(self, n: int) -> str:
        return str(self._outlet(n, "name"))

    def set_outlet_name(self, n: int, name: str) -> None:
        self._confirm(self.dev.set_outlet_name(n, name), f"rename outlet {n}")

    def get_outlet_switchable(self, n: int) -> bool:
        return bool(self._outlet(n, "switchable"))

    def set_outlet_switchable(self, n: int, switchable: bool) -> None:
        # The driver has no setter for Switchable, so build one from its GET template
        path = self.dev.get_outlet_commands["switchable"][0].format(n=n)
        self._confirm(self.dev._send_command(  # pylint: disable=protected-access
            f"set {path} {int(switchable)}"), f"set outlet {n} switchable state")

    def get_manufacturer(self) -> str:
        """Return the PDU manufacturer."""
        return self._device("manufacturer")

    def get_serial(self) -> str:
        """Return the PDU serial number."""
        return self._device("serial_number")

    def get_outlet_current(self, n: int) -> float:
        """Return outlet ``n`` current draw in amps."""
        return float(self._outlet(n, "current"))

    def get_outlet_power(self, n: int) -> float:
        """Return outlet ``n`` active power draw in watts."""
        return float(self._outlet(n, "active_power"))

    def get_outlet_energy(self, n: int) -> int:
        """Return outlet ``n`` energy since its last reset, in watt-hours."""
        return int(self._outlet(n, "energy"))

    def get_outlet_autorestart(self, n: int) -> int:
        """Return outlet ``n`` power-up behavior: 0 off, 1 on, 2 last state."""
        return int(self._outlet(n, "auto_restart"))

    def set_outlet_autorestart(self, n: int, value: int) -> None:
        """Set outlet ``n`` power-up behavior."""
        self._confirm(self.dev.set_autostart(n, value), f"set outlet {n} auto-restart")

    def reset_outlet_statistics(self, n: int) -> None:
        """Zero outlet ``n`` energy statistics on the PDU."""
        self._confirm(self.dev.reset_statistics(n), f"reset outlet {n} statistics")

    def register_device_keywords(self) -> None:
        super().register_device_keywords()
        self.keyword_registry.string("manufacturer",
                                     getter=self.when_connected("manufacturer",
                                                                self.get_manufacturer),
                                     description="PDU manufacturer.")
        self.keyword_registry.string("serial",
                                     getter=self.when_connected("serial", self.get_serial),
                                     description="PDU serial number.")

    def register_outlet_keywords(self, n: int) -> None:
        super().register_outlet_keywords(n)
        key = self.outlet_key(n)
        self.keyword_registry.float(
            f"current{key}",
            getter=self.when_connected(f"current{key}", self.get_outlet_current, n),
            units="A",
            description=f"Outlet {n} current draw.")
        self.keyword_registry.float(
            f"power{key}",
            getter=self.when_connected(f"power{key}", self.get_outlet_power, n),
            units="W",
            description=f"Outlet {n} active power draw.")
        self.keyword_registry.int(
            f"energy{key}",
            getter=self.when_connected(f"energy{key}", self.get_outlet_energy, n),
            units="Wh",
            description=f"Outlet {n} energy since the last statistics reset.")
        self.keyword_registry.int(
            f"autorestart{key}",
            getter=self.when_connected(f"autorestart{key}", self.get_outlet_autorestart, n),
            setter=self.when_connected(f"autorestart{key}", self.set_outlet_autorestart, n),
            validator=_check_autorestart,
            description=f"Outlet {n} power-up behavior after a PDU restart: "
                        "0=not powered, 1=powered, 2=last state.")
        self.keyword_registry.trigger(
            f"resetstatistics{key}",
            action=self.when_connected(f"resetstatistics{key}",
                                       self.reset_outlet_statistics, n),
            description=f"Reset the energy statistics for outlet {n}.")

    def _device(self, item: str) -> str:
        value = self.dev.get_atomic_value(item)
        if value is None:
            raise RuntimeError(f"failed to read '{item}' from PDU")
        return str(value)

    def _outlet(self, n: int, item: str) -> Any:
        # The driver names an outlet item by appending the outlet number
        value = self.dev.get_atomic_value(f"{item}{n}")
        if value is None:
            raise RuntimeError(f"failed to read outlet {n} {item}")
        return value


def _check_autorestart(value: int) -> str | None:
    if value not in AUTORESTART_VALUES:
        return "auto-restart must be 0 (not powered), 1 (powered) or 2 (last state)"
    return None


if __name__ == '__main__':
    main(EatonPdu, "LRIS2 Eaton EMAT-08/10 PDU daemon")
