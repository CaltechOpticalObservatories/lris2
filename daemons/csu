#!/usr/bin/env python3
'''LRIS2 CSU daemon: the slit bars as libby keywords, through the PLC or as EtherCAT master'''
import argparse
import json
import sys
import threading
from collections.abc import Callable, Mapping
from dataclasses import dataclass
from typing import Any, Final, Protocol

import pyads
from cooethercat import Axis, AxisError, AxisSet, CoeType, ControllerState
from cooethercat.backends.sim import open_simulated
from cooethercat.backends.soem import open_soem
from cooethercat.backends.twincat import open_twincat
from cooethercat.bus import EtherCATError
from cooethercat.config import Backend, TopologyConfig, parse_topology

from lris2.daemon import Lris2Daemon

# Errors a keyword turns into a libby error reply instead of crashing the daemon
TransportErrors = tuple[type[Exception], ...]


class Registry(Protocol):
    """The slice of libby's KeywordRegistry used here."""

    def bool(self, name: str, **options: Any) -> Any:
        """Register a bool keyword."""

    def int(self, name: str, **options: Any) -> Any:
        """Register an int keyword."""

    def float(self, name: str, **options: Any) -> Any:
        """Register a float keyword."""

    def string(self, name: str, **options: Any) -> Any:
        """Register a string keyword."""

    def trigger(self, name: str, **options: Any) -> Any:
        """Register a trigger keyword."""


@dataclass(frozen=True)
class Telemetry:
    """One EPOS4 object served as a read-only keyword."""

    keyword: str
    index: int
    subindex: int
    kind: CoeType
    scale: float
    units: str
    description: str


# EPOS4 objects; the motors have no temperature sensor, so motor I2t stands in for winding heat
TELEMETRY: Final = (
    Telemetry("boardtemp", 0x3201, 1, CoeType.INT16, 0.1, "C", "Drive power stage temperature"),
    Telemetry("i2tmotor", 0x3200, 1, CoeType.UINT16, 1.0, "%",
              "Drive thermal model of the motor winding"),
    Telemetry("i2tstage", 0x3200, 2, CoeType.UINT16, 1.0, "%",
              "Drive thermal model of the power stage"),
    Telemetry("current", 0x30D1, 1, CoeType.INT32, 1.0, "mA", "Motor current, averaged"),
    Telemetry("supply", 0x2200, 1, CoeType.UINT16, 0.1, "V", "Drive supply voltage"),
)


# The readings the browser demo charts per bar
_CHARTED: Final = tuple(item for item in TELEMETRY if item.keyword in ("boardtemp", "current"))


def bar_number(axis: Axis) -> int:
    """Return N for a bar named CSU-N, the suffix of its keywords."""
    return int(axis.name.rsplit("-", 1)[1])


class CsuKeywords:
    """Translate keyword reads and writes into axis commands and drive reads."""

    def __init__(self, axes: AxisSet, transport_errors: TransportErrors = (OSError,),
                 online: Callable[[], bool] = lambda: True) -> None:
        self._axes = axes
        self._online = online
        self._errors = (AxisError, *transport_errors)
        self._locks = {axis.name: threading.Lock() for axis in axes}

    def register(self, registry: Registry) -> None:
        """Register every bar's keywords plus the CSU-wide ones."""
        for axis in self._axes:
            self._register_bar(registry, axis)
        registry.bool("ismoving", getter=self._guard(self.any_moving),
                      description="Any bar is moving")
        registry.trigger("halt", action=self._guard(self.halt_all),
                         description="Stop every bar, continuing past failures")
        registry.string("status", getter=self._guard(self.status_json),
                        description="Every bar's readbacks as JSON, keyed by bar name")
        registry.string("telemetry", getter=self._guard(self.telemetry_json),
                        description="Every bar's board temperature (C) and current (mA) as JSON")

    def _register_bar(self, registry: Registry, axis: Axis) -> None:
        n, units = bar_number(axis), axis.config.units.name
        registry.float(f"positionvalue{n}", units=units,
                       getter=self._guard(lambda: round(axis.position, 4)),
                       setter=self._guard(lambda target: self.move_to(axis, float(target))),
                       description=f"{axis.name} position; a write is an absolute move")
        registry.float(f"velocity{n}", units=f"{units}/s",
                       getter=self._guard(lambda: float(axis.get("velocity"))),
                       setter=self._guard(lambda value: self.set_velocity(axis, float(value))),
                       description=f"{axis.name} profile velocity for moves")
        registry.bool(f"ismoving{n}", getter=self._guard(lambda: axis.moving),
                      description=f"{axis.name} is moving")
        registry.bool(f"isenabled{n}", getter=self._guard(lambda: axis.enabled),
                      setter=self._guard(lambda on: self.set_enabled(axis, bool(on))),
                      description=f"{axis.name} drive is energised; write to switch")
        registry.int(f"error{n}", getter=self._guard(lambda: axis.error_id if axis.error else 0),
                     description=f"{axis.name} latched fault id, 0 when clear")
        registry.trigger(f"halt{n}", action=self._guard(axis.stop),
                         description=f"Stop {axis.name}")
        registry.trigger(f"reset{n}", action=self._guard(axis.reset),
                         description=f"Clear a latched fault on {axis.name}")
        for item in TELEMETRY:
            registry.float(f"{item.keyword}{n}", units=item.units,
                           getter=self._guard(lambda item=item: self.read_telemetry(axis, item)),
                           description=f"{axis.name}: {item.description}")

    def move_to(self, axis: Axis, target: float) -> None:
        """Start an absolute move, refusing while the bar is already moving."""
        with self._locks[axis.name]:
            if axis.moving:
                raise AxisError(f"{axis.name} is already moving")
            # A bar never given a velocity holds 0, which the PLC would fault on
            velocity = float(axis.get("velocity")) or axis.config.limits.velocity
            axis.move_absolute(target, velocity=velocity, wait=False)

    def set_velocity(self, axis: Axis, value: float) -> None:
        """Set the profile velocity used by later moves, within the bar's limit."""
        limit = axis.config.limits.velocity
        if not 0 < value <= limit:
            raise AxisError(f"{axis.name} velocity must be in (0, {limit}]")
        axis.set("velocity", value)

    def set_enabled(self, axis: Axis, on: bool) -> None:
        """Energise or de-energise a bar's drive and wait for it to follow."""
        with self._locks[axis.name]:
            if on:
                axis.enable()
            else:
                axis.disable()

    def read_telemetry(self, axis: Axis, item: Telemetry) -> float:
        """Read one drive object and scale it to engineering units."""
        return round(float(axis.read_object(item.index, item.subindex, item.kind)) * item.scale, 2)

    def status_json(self) -> str:
        """Return every bar's status snapshot as one JSON object."""
        return json.dumps({axis.name: axis.status() for axis in self._axes})

    def telemetry_json(self) -> str:
        """Return every bar's board temperature and current, null where a drive fails to answer."""
        readings: dict[str, dict[str, float | None]] = {}
        for axis in self._axes:
            values: dict[str, float | None] = {}
            for item in _CHARTED:
                try:
                    values[item.keyword] = self.read_telemetry(axis, item)
                except self._errors:
                    values[item.keyword] = None
            readings[axis.name] = values
        return json.dumps(readings)

    def any_moving(self) -> bool:
        """Return whether any bar is moving."""
        return any(axis.moving for axis in self._axes)

    def halt_all(self) -> None:
        """Stop every bar, raising afterwards if any of them could not be told to."""
        failures = []
        for axis in self._axes:
            try:
                axis.stop()
            except self._errors as error:
                failures.append(f"{axis.name}: {error}")
        if failures:
            raise RuntimeError("halt failed for " + "; ".join(failures))

    def _guard(self, call: Callable[..., Any]) -> Callable[..., Any]:
        """Report axis and transport failures as RuntimeError, which libby replies with."""
        def guarded(*args: Any) -> Any:
            # Fail fast while the link is down, so a reader of every keyword is not held up
            if not self._online():
                raise RuntimeError("PLC unreachable")
            try:
                return call(*args)
            except self._errors as error:
                raise RuntimeError(str(error)) from error
        return guarded


TRANSPORT_ERRORS = (OSError, pyads.ADSError, EtherCATError)
OPENERS: Final[dict[Backend, Callable[[TopologyConfig], AxisSet]]] = {
    Backend.SIM: open_simulated,
    Backend.TWINCAT: open_twincat,
    Backend.PYSOEM: open_soem,
}

# How often the watchdog checks the PLC link, and so how soon a dropped link heals
WATCHDOG_S = 5.0
UNREACHABLE = "unreachable"


def csu_topology(topology: Mapping[str, Any], transports: Mapping[str, Any],
                 master: str, sim: bool) -> TopologyConfig:
    """Return the bars under the chosen EtherCAT master's transport, or simulated."""
    if sim:
        return parse_topology({**topology, "backend": Backend.SIM.value}, source="topology")
    return parse_topology({**topology, "backend": master, "transport": transports.get(master)},
                          source=f"topology under {master}")


class Csu(Lris2Daemon):  # pylint: disable=W0223
    '''Daemon for the LRIS2 configurable slit unit'''

    group_id = "lris2"
    topics = {}

    def __init__(self):
        super().__init__()
        self.axes: AxisSet | None = None
        self.keywords: CsuKeywords | None = None
        self.topology: TopologyConfig | None = None
        self._stopping = threading.Event()
        self._link_up = threading.Event()
        self._link_up.set()

    def on_start(self):
        '''Register keywords, then connect; the daemon stays up if the PLC is unreachable'''
        self.topology = csu_topology(self.get_config("topology"), self.get_config("transports", {}),
                                     self.get_config("hardware.master", Backend.TWINCAT.value),
                                     bool(self.get_config("hardware.sim", False)))
        self.axes = OPENERS[self.topology.backend](self.topology)
        self.keywords = CsuKeywords(self.axes, TRANSPORT_ERRORS, self._link_up.is_set)
        self.keywords.register(self.keyword_registry)
        self.keyword_registry.bool("isconnected", getter=self.is_connected,
                                   setter=self.set_connected,
                                   description="PLC reachable; write true to reconnect")
        self.keyword_registry.string("plcstate", getter=self.plc_state,
                                     description="PLC run, stop, config, other or unreachable")
        self.keyword_registry.trigger("shutdown", action=self.shutdown,
                                      description="Stop the daemon; refused while a bar moves")
        self.logger.info("CSU daemon serving %d bars over %s", len(self.axes),
                         self.topology.backend)
        threading.Thread(target=self._watch_link, name="plc link", daemon=True).start()

    def on_stop(self):
        '''Close the PLC connection; the PLC keeps each bar's enable state'''
        self._stopping.set()
        if self.axes is not None:
            self.axes.backend.close()

    def is_connected(self) -> bool:
        '''Return whether the PLC is in Run and a status read reaches it'''
        if not self._link_up.is_set():
            return False
        try:
            if self.axes.backend.controller_state() is not ControllerState.RUN:
                return False
            next(iter(self.axes)).status()
        except (AxisError, *TRANSPORT_ERRORS):
            return False
        return True

    def plc_state(self) -> str:
        '''Return the PLC runtime mode, as read from the TwinCAT system service'''
        if not self._link_up.is_set():
            return UNREACHABLE
        try:
            return str(self.axes.backend.controller_state())
        except TRANSPORT_ERRORS:
            return UNREACHABLE

    def set_connected(self, value) -> None:
        '''Reconnect on true; false is refused, since keywords need the connection'''
        if not value:
            raise RuntimeError("the CSU daemon always holds its PLC connection")
        self.axes.backend.close()
        self.axes.backend.open()

    def _watch_link(self) -> None:
        '''Reopen the PLC link whenever a status read fails, e.g. after a drive power cycle'''
        failing = False
        while not self._stopping.wait(WATCHDOG_S):
            try:
                next(iter(self.axes)).status()
            except TRANSPORT_ERRORS as error:
                if not failing:
                    self.logger.warning("PLC link lost (%s); reconnecting", error)
                failing = True
                self._link_up.clear()
                self._reopen()
                continue
            if failing:
                self.logger.info("PLC link restored")
            failing = False
            self._link_up.set()

    def _reopen(self) -> None:
        try:
            self.axes.backend.close()
            self.axes.backend.open()
        except TRANSPORT_ERRORS as error:
            self.logger.debug("reconnect failed: %s", error)

    def shutdown(self) -> None:
        '''Stop the daemon unless a bar is moving'''
        if self.keywords.any_moving():
            raise RuntimeError("a bar is moving; halt first")
        self.request_stop()


def main():
    '''Parse arguments and serve until stopped'''
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("-c", "--config", required=True, help="daemon config YAML")
    parser.add_argument("-d", "--daemon-id", help="override peer_id")
    args = parser.parse_args()
    Csu.from_config_file(args.config, args.daemon_id).serve()


if __name__ == "__main__":
    sys.exit(main())
