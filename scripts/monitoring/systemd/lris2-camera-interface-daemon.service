[Unit]
Description=LRIS2 camera-interface daemon (Archon telemetry via camerad)
Documentation=file:/home/l2dev/apps/lris2/daemons/camera-interface
After=network-online.target lris2-camerad.service rabbitmq-server.service
Wants=network-online.target lris2-camerad.service rabbitmq-server.service

# Mutually exclusive with the old direct-to-camerad collector: both are
# automated camerad clients, and only one should poll STATUS/FRAME at a time.
Conflicts=lris2-archon-collector.service
After=lris2-archon-collector.service

[Service]
Type=simple
User=l2dev
Group=l2dev
# TODO(deploy): confirm checkout path and venv once M4 lands.
WorkingDirectory=/home/l2dev/apps/lris2
ExecStart=/home/l2dev/apps/lris2/.venv/bin/python3 /home/l2dev/apps/lris2/daemons/camera-interface -c /home/l2dev/apps/lris2/config/lris2_camera.yaml
Restart=on-failure
RestartSec=10s

StandardOutput=journal
StandardError=journal

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
