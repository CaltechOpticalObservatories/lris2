[Unit]
Description=LRIS2 camera-interface daemon (Archon telemetry via camerad)
Documentation=file:/home/l2dev/apps/lris2-camera-interface-daemon/daemons/camera-interface
After=network-online.target lris2-camerad.service rabbitmq-server.service
Wants=network-online.target lris2-camerad.service rabbitmq-server.service

# TODO(cutover): this runs alongside the old lris2-archon-collector.service
# for now (deliberate - no side-by-side comparison needed, just deploy ahead
# of switching). Add `Conflicts=lris2-archon-collector.service` (+ ordering)
# back once ready to cut over, so starting this stops the old one.

[Service]
Type=simple
User=l2dev
Group=l2dev
# NOTE: separate checkout from /home/l2dev/apps/lris2 (which stays on main
# until this branch merges). Update once the final deploy location is chosen.
WorkingDirectory=/home/l2dev/apps/lris2-camera-interface-daemon
ExecStart=/home/l2dev/apps/lris2-camera-interface-daemon/.venv/bin/python3 /home/l2dev/apps/lris2-camera-interface-daemon/daemons/camera-interface -c /home/l2dev/apps/lris2-camera-interface-daemon/config/lris2_camera.yaml
Restart=on-failure
RestartSec=10s

StandardOutput=journal
StandardError=journal

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
