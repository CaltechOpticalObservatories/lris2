[Unit]
Description=LRIS2 camera telemetry -> InfluxDB shipper (reads camera-interface daemon keywords)
Documentation=file:/home/l2dev/apps/lris2-camera-interface-daemon/scripts/monitoring/camera_telemetry_shipper.py
After=network-online.target lris2-camera-interface-daemon.service
Wants=network-online.target
Requires=lris2-camera-interface-daemon.service

# TODO(cutover): this writes the same InfluxDB measurements as the old
# lris2-archon-collector.service and runs alongside it for now (deliberate -
# no side-by-side comparison needed, just deploy ahead of switching). Add
# `Conflicts=lris2-archon-collector.service` (+ ordering) back once ready to
# cut over, so starting this stops the old one.

[Service]
Type=simple
User=l2dev
Group=l2dev
# NOTE: separate checkout from /home/l2dev/apps/lris2 (which stays on main
# until this branch merges). Update once the final deploy location is chosen.
WorkingDirectory=/home/l2dev/apps/lris2-camera-interface-daemon
EnvironmentFile=/etc/lris2/influxdb.env
ExecStart=/home/l2dev/apps/lris2-camera-interface-daemon/.venv/bin/python3 /home/l2dev/apps/lris2-camera-interface-daemon/scripts/monitoring/camera_telemetry_shipper.py --peer lris2_camera
Restart=on-failure
RestartSec=10s

StandardOutput=journal
StandardError=journal

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
