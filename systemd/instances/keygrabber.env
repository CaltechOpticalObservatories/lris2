# Keyword archiver: polls the LRIS2 daemons into InfluxDB for Grafana
#
# lris2 deploy keygrabber
#
# Deployed alongside this file by the CLI:
#   config/<subsystem>/keygrabber.yaml -> /etc/lris2/keygrabber.yaml
#
# The InfluxDB token goes in root-only /etc/lris2/secrets.env, not here:
#   LRIS2_INFLUX_TOKEN=<token>
LRIS2_DAEMON=keygrabber
LRIS2_CONFIG=/etc/lris2/keygrabber.yaml
