# RCam: Archon detector controller, Red channel
#
# lris2 deploy rcam
#
# Deployed alongside this file by the CLI:
#   config/r/rcam.yaml -> /etc/lris2/rcam.yaml
#
# Needs the instrument's camera_interface build in the venv, which is not a
# git dependency: pip install <lris2-camerad-instrument>
LRIS2_DAEMON=camera
