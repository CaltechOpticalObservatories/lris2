      },
      "description": "Age of the newest keygrabber sample from rcam. Climbing means the Archon link is closed (libby modify lris2.rcam.isopen true) or the keygrabber is down.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "displayName": "${__field.labels._field}",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 90
              },
              {
                "color": "red",
                "value": 300
              }
            ]
          },
          "unit": "s",
          "decimals": 0
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "id": 2,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "wideLayout": true
      },
      "pluginVersion": "11.2.0",
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "edy7o8tiy9s00e"
          },
          "query": "from(bucket: \"LRIS2\")\n  |> range(start: -24h)\n  |> filter(fn: (r) => r.peer == \"rcam\" and r._measurement == \"heaterxcryotemp\")\n  |> last()\n  |> map(fn: (r) => ({_time: r._time, _field: \"rcam\", _value: float(v: int(v: now()) - int(v: r._time)) / 1000000000.0}))",
          "refId": "A"
        }
      ],
      "title": "Last rcam sample",
      "type": "stat"
    },
