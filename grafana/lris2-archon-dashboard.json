        }
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "edy7o8tiy9s00e"
          },
          "query": "import \"strings\"\nfrom(bucket: \"LRIS2\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r.peer == \"rcam\" and r._measurement =~ /^heaterx.*temp$/)\n  |> filter(fn: (r) => r._value > -273.0)\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n  |> map(fn: (r) => ({r with _field: strings.trimSuffix(v: strings.trimPrefix(v: r._measurement, prefix: \"heaterx\"), suffix: \"temp\")}))\n  |> keep(columns: [\"_time\", \"_value\", \"_field\"])\n  |> group(columns: [\"_field\"])",
          "refId": "A"
        }
      ],
      "title": "Temperatures",
      "type": "timeseries"
    },
